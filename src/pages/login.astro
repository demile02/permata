---
import Layout from '../layouts/Layout.astro';
import { isLoggedIn } from '../lib/auth';

const cookies = Astro.request.headers.get('cookie');
if (isLoggedIn(cookies)) {
  return Astro.redirect('/');
}
---

<Layout title="Masuk Redaksi - Permata" description="Halaman masuk khusus redaksi Permata">
  <div class="mx-auto max-w-sm py-6">
    <div class="text-center">
      <span class="font-display mx-auto grid h-14 w-14 place-items-center rounded-full border border-madrasah/25 bg-kabut text-2xl font-bold text-madrasah" aria-hidden="true">P</span>
      <h1 class="font-display mt-4 text-3xl font-bold text-rimba">Masuk Redaksi</h1>
      <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">Khusus redaksi Permata. Kelola dan publikasikan berita kegiatan magang.</p>
    </div>
    <form id="form-login" class="mt-6 space-y-4 rounded-2xl border border-neutral-200 bg-kertas p-6 shadow-sm">
      <div>
        <label class="mb-1.5 block text-sm font-bold text-rimba" for="username">Nama pengguna</label>
        <input id="username" name="username" required autocomplete="username" placeholder="cth: redaksi" class="w-full min-h-[48px] rounded-xl border border-neutral-300 bg-kertas px-4 py-3 text-[15px] text-neutral-900 placeholder:text-neutral-400 transition focus:border-madrasah focus:outline-none focus:ring-2 focus:ring-madrasah/25" />
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-bold text-rimba" for="password">Kata sandi</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="Masukkan kata sandi" class="w-full min-h-[48px] rounded-xl border border-neutral-300 bg-kertas px-4 py-3 text-[15px] text-neutral-900 placeholder:text-neutral-400 transition focus:border-madrasah focus:outline-none focus:ring-2 focus:ring-madrasah/25" />
      </div>
      <div id="status" class="hidden text-sm rounded-xl px-4 py-3" role="alert"></div>
      <button type="submit" id="btn" class="inline-flex w-full min-h-[52px] items-center justify-center rounded-full bg-madrasah px-6 py-3 text-[15px] font-bold text-white transition hover:bg-madrasah-deep disabled:opacity-50">
        Masuk
      </button>
    </form>
    <p class="mt-5 text-center text-xs text-neutral-500">
      <a href="/" class="inline-flex min-h-[44px] items-center font-semibold text-madrasah underline decoration-kunyit decoration-2 underline-offset-4 hover:text-madrasah-deep">Kembali ke beranda</a>
    </p>
  </div>

  <script>
    const form = document.getElementById('form-login') as HTMLFormElement;
    const statusEl = document.getElementById('status') as HTMLDivElement;
    const btn = document.getElementById('btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Memeriksa...';
      statusEl.classList.add('hidden');
      try {
        const r = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: (document.getElementById('username') as HTMLInputElement).value,
            password: (document.getElementById('password') as HTMLInputElement).value,
          }),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || 'Login gagal.');
        window.location.href = '/';
      } catch (err: any) {
        statusEl.classList.remove('hidden');
        statusEl.textContent = err.message || 'Login gagal.';
        statusEl.className = 'text-sm rounded-xl px-4 py-3 bg-red-50 text-red-800 border border-red-200';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Masuk';
      }
    });
  </script>
</Layout>
