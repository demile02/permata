---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;
const { data } = await supabase
  .from('berita')
  .select('*, kategori:kategori_id(nama)')
  .eq('slug', slug)
  .eq('status', 'published')
  .single();

if (!data) {
  return Astro.redirect('/404');
}

// Tambah hitungan views
await supabase.from('berita').update({ views: (data.views ?? 0) + 1 }).eq('id', data.id);

const b: any = data;
const tanggal = new Date(b.created_at).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

// Ambil berita terkait
const { data: related } = await supabase
  .from('berita')
  .select('id, judul, slug, ringkasan, gambar_url, penulis, created_at, kategori:kategori_id(nama)')
  .eq('status', 'published')
  .neq('id', b.id)
  .order('created_at', { ascending: false })
  .limit(3);
---

<Layout title={`${b.judul} - Permata`} description={b.ringkasan}>
  <article class="mx-auto max-w-3xl">
    <a href="/" class="inline-flex min-h-[44px] items-center gap-2 text-sm font-bold text-madrasah transition hover:text-madrasah-deep">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Kembali ke Beranda
    </a>

    <div class="mt-4">
      <p>
        <span class="inline-flex items-center rounded-full border border-kunyit/50 bg-kunyit-lembut px-3 py-1 text-xs font-bold uppercase tracking-wide text-kunyit-tua">{b.kategori?.nama ?? 'Berita'}</span>
      </p>
      <h1 class="font-display mt-3 text-3xl font-bold leading-tight text-rimba sm:text-[2.75rem] sm:leading-[1.15]">{b.judul}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 border-y border-neutral-200 py-3 text-[13px] text-neutral-500">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-madrasah" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          <span class="font-semibold text-neutral-700">{b.penulis}</span>
        </span>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-madrasah" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          {tanggal}
        </span>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-madrasah" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          {(b.views ?? 0) + 1} kali dibaca
        </span>
      </p>
    </div>

    {b.gambar_url && (
      <figure class="bingkai-lengkung mt-8 overflow-hidden border border-neutral-200 bg-kabut">
        <img src={b.gambar_url} alt={b.judul} class="max-h-[26rem] w-full object-cover" />
      </figure>
    )}

    <div class="prose-berita mt-8">
      <p class="leadin">{b.ringkasan}</p>
      {b.isi.split('\n').map((p: string) => {
        const t = p.trim();
        if (!t) return null;
        // Sintaks gambar: ![keterangan](url)
        const imgMatch = t.match(/^\!\[(.*?)\]\((.*?)\)$/);
        if (imgMatch) {
          return (
            <figure>
              <img src={imgMatch[2]} alt={imgMatch[1]} class="w-full rounded-xl object-cover" loading="lazy" />
              {imgMatch[1] && <figcaption>{imgMatch[1]}</figcaption>}
            </figure>
          );
        }
        return <p>{t}</p>;
      })}
    </div>
  </article>

  {related && related.length > 0 && (
    <section class="mx-auto mt-14 max-w-3xl" aria-label="Berita terkait">
      <div class="mb-5 flex items-center gap-3">
        <span class="h-7 w-1.5 shrink-0 rounded-full bg-kunyit" aria-hidden="true"></span>
        <h2 class="font-display text-2xl font-bold text-rimba">Berita Terkait</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {(related as any[]).map((r) => (
          <a href={`/berita/${r.slug}`} class="group flex min-h-[44px] flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-kertas transition hover:border-madrasah/40 hover:shadow-md">
            {r.gambar_url && <span class="block overflow-hidden"><img src={r.gambar_url} alt={r.judul} loading="lazy" class="h-28 w-full object-cover transition duration-300 group-hover:scale-105" /></span>}
            <span class="flex flex-1 flex-col p-4">
              <span class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-madrasah">{r.kategori?.nama ?? 'Berita'}</span>
              <span class="font-display block text-[15px] font-bold leading-snug text-rimba line-clamp-2 group-hover:underline decoration-kunyit underline-offset-4">{r.judul}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
