---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import { isLoggedIn } from '../lib/auth';

if (!isLoggedIn(Astro.request.headers.get('cookie'))) {
  return Astro.redirect('/login');
}

const { data: kategoriList } = await supabase.from('kategori').select('id, nama').order('nama');

const field = 'w-full min-h-[48px] rounded-xl border border-neutral-300 bg-kertas px-4 py-3 text-[15px] text-neutral-900 placeholder:text-neutral-400 transition focus:border-madrasah focus:outline-none focus:ring-2 focus:ring-madrasah/25';
const label = 'mb-1.5 block text-sm font-bold text-rimba';
---

<Layout title="Kirim Berita - Permata" description="Formulir pengiriman berita kegiatan magang">
  <div class="mx-auto max-w-2xl">
    <p class="inline-flex items-center rounded-full bg-kabut px-3 py-1 text-xs font-bold uppercase tracking-wider text-madrasah">Kontribusi pembaca</p>
    <h1 class="font-display mt-3 text-3xl font-bold text-rimba sm:text-4xl">Kirim Berita</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-neutral-600">Bagikan laporan kegiatan magangmu. Berita akan ditinjau redaksi sebelum dipublikasikan.</p>

    <form id="form-berita" class="mt-6 space-y-5 rounded-2xl border border-neutral-200 bg-kertas p-5 shadow-sm sm:p-7">
      <div>
        <label class={label} for="judul">Judul Berita *</label>
        <input id="judul" name="judul" required maxlength="120" class={field} placeholder="cth: Kunjungan Industri ke PT Maju Bersama" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class={label} for="kategori">Kategori *</label>
          <select id="kategori" name="kategori" required class={field}>
            <option value="">Pilih kategori</option>
            {(kategoriList ?? []).map((k: any) => <option value={k.id}>{k.nama}</option>)}
          </select>
        </div>
        <div>
          <label class={label} for="penulis">Nama Penulis *</label>
          <input id="penulis" name="penulis" required maxlength="60" class={field} placeholder="Nama kamu" />
        </div>
      </div>

      <div>
        <label class={label} for="ringkasan">Ringkasan *</label>
        <textarea id="ringkasan" name="ringkasan" required rows="2" maxlength="300" class={field} placeholder="1-2 kalimat pembuka berita..."></textarea>
        <p class="mt-1.5 text-xs text-neutral-500">Tulis pembuka yang memancing rasa ingin tahu dalam satu atau dua kalimat.</p>
      </div>

      <div>
        <label class={label} for="isi">Isi Berita *</label>
        <textarea id="isi" name="isi" required rows="8" class={field} placeholder="Tulis laporan kegiatan secara lengkap..."></textarea>
        <p class="mt-1.5 text-xs leading-relaxed text-neutral-500">Untuk sisipkan foto di tengah artikel, tulis di baris tersendiri: <code class="rounded bg-kabut px-1.5 py-0.5 font-mono text-madrasah-deep">![keterangan foto](url-gambar)</code></p>
      </div>

      <div class="rounded-xl border border-dashed border-madrasah/30 bg-kabut/50 p-4">
        <label class={label} for="gambar">Foto Utama</label>
        <input id="gambar" name="gambar" type="file" accept="image/*" class="block w-full min-h-[44px] text-sm text-neutral-600 file:mr-3 file:min-h-[44px] file:rounded-full file:border-0 file:bg-madrasah file:px-4 file:py-2.5 file:text-sm file:font-bold file:text-white hover:file:bg-madrasah-deep" />
        <p class="mt-1.5 text-xs text-neutral-500">Opsional, ukuran maksimal 5MB. Foto ini tampil sebagai gambar sampul berita.</p>
      </div>

      <div class="rounded-xl border border-madrasah/15 bg-kabut p-4 sm:p-5">
        <p class="text-sm font-bold text-rimba">Foto Tambahan</p>
        <p class="mt-0.5 text-xs text-neutral-500">Untuk disisipkan di tengah artikel.</p>
        <input id="gambar-extra" type="file" accept="image/*" multiple class="mt-3 block w-full min-h-[44px] text-sm text-neutral-600 file:mr-3 file:min-h-[44px] file:rounded-full file:border-0 file:bg-kertas file:px-4 file:py-2.5 file:text-sm file:font-bold file:text-madrasah hover:file:bg-kunyit-lembut" />
        <button type="button" id="btn-upload-extra" class="mt-3 inline-flex min-h-[44px] items-center rounded-full bg-rimba px-5 py-2.5 text-sm font-bold text-white transition hover:bg-madrasah-deep disabled:opacity-50">Upload Foto Tambahan</button>
        <div id="extra-list" class="mt-2 space-y-1.5 text-xs"></div>
        <p class="mt-2 text-xs text-neutral-500">Upload foto, lalu klik kode yang muncul untuk menyalin dan menempelkannya ke isi berita.</p>
      </div>

      <div id="status" class="hidden text-sm rounded-xl px-4 py-3" role="status" aria-live="polite"></div>

      <button type="submit" id="btn-submit" class="inline-flex w-full min-h-[52px] items-center justify-center rounded-full bg-madrasah px-6 py-3.5 text-[15px] font-bold text-white transition hover:bg-madrasah-deep disabled:opacity-50">
        Kirim Berita
      </button>
      <p class="text-center text-xs text-neutral-500">Dengan mengirim, kamu menyetujui pedoman redaksi.</p>
    </form>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('form-berita') as HTMLFormElement;
    const statusEl = document.getElementById('status') as HTMLDivElement;
    const btn = document.getElementById('btn-submit') as HTMLButtonElement;

    function setStatus(msg: string, ok: boolean) {
      statusEl.classList.remove('hidden');
      statusEl.textContent = msg;
      statusEl.className = `text-sm rounded-xl px-4 py-3 ${ok ? 'bg-kabut text-madrasah-deep border border-madrasah/30' : 'bg-red-50 text-red-800 border border-red-200'}`;
    }

    function slugify(s: string) {
      return s.toLowerCase().trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .slice(0, 80) + '-' + Date.now().toString(36);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Mengirim...';

      try {
        const fd = new FormData(form);
        const judul = String(fd.get('judul'));
        let gambar_url: string | null = null;

        const fileInput = document.getElementById('gambar') as HTMLInputElement;
        const file = fileInput.files?.[0];
        if (file) {
          if (file.size > 5 * 1024 * 1024) throw new Error('Ukuran gambar maksimal 5MB.');

          // Mode lokal: upload via API internal ke public/uploads
          // Mode Supabase: upload via Supabase Storage
          const isLocal = import.meta.env.PUBLIC_LOCAL_UPLOAD === 'true';

          if (isLocal) {
            const upData = new FormData();
            upData.append('file', file);
            const upRes = await fetch('/api/upload', { method: 'POST', body: upData });
            const upJson = await upRes.json();
            if (!upRes.ok) throw new Error('Upload gambar gagal: ' + (upJson.error || ''));
            gambar_url = upJson.url;
          } else {
            const ext = file.name.split('.').pop();
            const path = `berita/${Date.now()}.${ext}`;
            const { error: upErr } = await supabase.storage.from('berita').upload(path, file);
            if (upErr) throw new Error('Upload gambar gagal: ' + upErr.message);
            const { data } = supabase.storage.from('berita').getPublicUrl(path);
            gambar_url = data.publicUrl;
          }
        }

        const { error } = await supabase.from('berita').insert({
          judul,
          slug: slugify(judul),
          ringkasan: String(fd.get('ringkasan')),
          isi: String(fd.get('isi')),
          kategori_id: String(fd.get('kategori')),
          penulis: String(fd.get('penulis')),
          gambar_url,
          status: 'draft',
        });

        if (error) throw error;
        setStatus('Berita terkirim. Menunggu tinjauan redaksi sebelum dipublikasikan.', true);
        form.reset();
      } catch (err: any) {
        setStatus(err.message || 'Gagal mengirim.', false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Kirim Berita';
      }
    });

    // Upload foto tambahan untuk disisipkan di tengah artikel
    const btnExtra = document.getElementById('btn-upload-extra') as HTMLButtonElement;
    const extraInput = document.getElementById('gambar-extra') as HTMLInputElement;
    const extraList = document.getElementById('extra-list') as HTMLDivElement;
    const isiField = document.getElementById('isi') as HTMLTextAreaElement;
    const isLocal = import.meta.env.PUBLIC_LOCAL_UPLOAD === 'true';

    async function uploadOne(file: File): Promise<string> {
      if (file.size > 5 * 1024 * 1024) throw new Error(`"${file.name}" melebihi 5MB.`);
      if (isLocal) {
        const fd = new FormData();
        fd.append('file', file);
        const r = await fetch('/api/upload', { method: 'POST', body: fd });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || 'Upload gagal');
        return j.url;
      } else {
        const ext = file.name.split('.').pop();
        const path = `berita/${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
        const { error } = await supabase.storage.from('berita').upload(path, file);
        if (error) throw new Error(error.message);
        return supabase.storage.from('berita').getPublicUrl(path).data.publicUrl;
      }
    }

    btnExtra.addEventListener('click', async () => {
      const files = extraInput.files;
      if (!files || files.length === 0) {
        setStatus('Pilih dulu foto tambahannya.', false);
        return;
      }
      btnExtra.disabled = true;
      btnExtra.textContent = 'Mengupload...';
      try {
        for (const file of Array.from(files)) {
          const url = await uploadOne(file);
          const code = `![${file.name}](${url})`;
          const div = document.createElement('div');
          div.className = 'bg-white border border-neutral-200 rounded-xl px-3 py-2 flex justify-between items-center gap-2';
          const span = document.createElement('code');
          span.className = 'truncate cursor-pointer hover:text-madrasah min-h-[44px] flex items-center';
          span.textContent = code;
          span.title = 'Klik untuk salin dan sisipkan ke isi berita';
          span.addEventListener('click', () => {
            navigator.clipboard.writeText(code);
            isiField.value += (isiField.value.endsWith('\n') || isiField.value === '' ? '' : '\n') + code + '\n';
            isiField.focus();
            span.textContent = 'Disalin dan disisipkan ke isi berita.';
            setTimeout(() => { span.textContent = code; }, 1500);
          });
          div.appendChild(span);
          extraList.appendChild(div);
        }
        setStatus(`${files.length} foto terupload. Klik kodenya untuk disisipkan ke artikel.`, true);
        extraInput.value = '';
      } catch (e: any) {
        setStatus(e.message || 'Upload gagal.', false);
      } finally {
        btnExtra.disabled = false;
        btnExtra.textContent = 'Upload Foto Tambahan';
      }
    });
  </script>
</Layout>
