---
import '../styles/global.css';
import { isLoggedIn } from '../lib/auth';

interface Props {
  title?: string;
  description?: string;
  activeKategori?: string | null;
}

const { title = 'Permata', description = 'Portal Berita Magang MAN Kota Blitar 2026', activeKategori = null } = Astro.props;
const loggedIn = isLoggedIn(Astro.request.headers.get('cookie'));
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="max-w-6xl mx-auto">
  <!-- Header -->
  <header class="border-b-4 border-red-700">
    <div class="px-4 py-5 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo-man.png" alt="Logo MAN Kota Blitar" class="w-12 h-12 object-contain" />
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight">PERMATA</h1>
          <p class="text-xs text-neutral-500 hidden sm:block">Portal Berita Magang MAN Kota Blitar 2026</p>
        </div>
      </a>
      {loggedIn ? (
        <div class="flex items-center gap-2">
          <a href="/kirim" class="bg-red-700 hover:bg-red-800 text-white text-sm font-semibold px-4 py-2 rounded transition">
            + Kirim Berita
          </a>
          <a href="/api/logout" class="text-sm text-neutral-500 hover:text-red-700 px-2 py-2">Keluar</a>
        </div>
      ) : (
        <a href="/login" class="text-sm text-neutral-500 hover:text-red-700 font-medium px-4 py-2">Login</a>
      )}
    </div>
    <!-- Nav -->
    <nav class="bg-neutral-100 border-t">
      <div class="px-4 flex gap-1 overflow-x-auto text-sm font-medium">
        {[
          { href: '/', label: 'Beranda', key: null },
          { href: '/?kategori=kegiatan', label: 'Kegiatan', key: 'kegiatan' },
          { href: '/?kategori=prestasi', label: 'Prestasi', key: 'prestasi' },
          { href: '/tentang', label: 'Tentang', key: 'tentang' },
        ].map((item) => {
          const isActive = activeKategori === item.key || (item.key === 'tentang' && Astro.url.pathname === '/tentang');
          return (
            <a
              href={item.href}
              class:list={[
                'px-4 py-3 whitespace-nowrap transition-colors',
                isActive ? 'bg-white text-red-700 font-bold' : 'hover:bg-white hover:text-red-700',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </nav>
  </header>

  <main class="px-4 py-8 min-h-[60vh]">
    <slot />
  </main>

  <footer class="bg-neutral-900 text-neutral-400 mt-12">
    <div class="px-4 py-3.5 flex flex-col sm:flex-row gap-3 text-sm">
      <div class="flex items-center gap-2">
        <span class="text-white font-extrabold">PERMATA</span>
        <span class="text-neutral-600 text-xs">Portal Berita Magang MAN Kota Blitar</span>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs sm:ml-auto sm:items-center">
        <a href="/?kategori=kegiatan" class="hover:text-white transition">Kegiatan</a>
        <a href="/?kategori=prestasi" class="hover:text-white transition">Prestasi</a>
        <a href="/tentang" class="hover:text-white transition">Tentang</a>
        <a href="/kirim" class="hover:text-white transition">Kirim Berita</a>
      </div>
    </div>
    <div class="border-t border-neutral-800 text-center text-[11px] py-1.5 text-neutral-600">
      &copy; 2026 Permata - Bukan situs resmi MAN Kota Blitar
    </div>
  </footer>
  </div>
</body>
</html>
