---
import type { Berita } from '../lib/supabase';

interface Props {
  berita: Berita & { kategori_nama?: string };
  featured?: boolean;
}

const { berita, featured = false } = Astro.props;
const tanggal = new Date(berita.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---

{featured ? (
  <a href={`/berita/${berita.slug}`} class="group relative block overflow-hidden rounded-2xl bg-rimba text-white">
    {berita.gambar_url ? (
      <img src={berita.gambar_url} alt={berita.judul} class="absolute inset-0 h-full w-full object-cover opacity-60 transition duration-300 group-hover:opacity-50" />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-madrasah-deep via-rimba to-rimba" aria-hidden="true"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-rimba via-rimba/50 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-1.5 bg-kunyit" aria-hidden="true"></div>
    <div class="relative flex min-h-[320px] flex-col justify-end p-6 pt-12 sm:min-h-[400px] sm:p-8">
      <p class="mb-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-kunyit px-3 py-1 text-xs font-bold uppercase tracking-wide text-rimba">{berita.kategori_nama ?? 'Berita'}</span>
        <span class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white">Sorotan</span>
      </p>
      <h2 class="font-display max-w-3xl text-2xl font-bold leading-tight decoration-kunyit decoration-2 underline-offset-4 group-hover:underline sm:text-4xl">{berita.judul}</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/85 line-clamp-2 sm:text-[15px]">{berita.ringkasan}</p>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-white/75">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          {berita.penulis}
        </span>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          {tanggal}
        </span>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          {berita.views ?? 0} kali dibaca
        </span>
      </p>
    </div>
  </a>
) : (
  <a href={`/berita/${berita.slug}`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-kertas transition duration-300 hover:-translate-y-0.5 hover:border-madrasah/40 hover:shadow-lg hover:shadow-rimba/10">
    {berita.gambar_url ? (
      <span class="block overflow-hidden">
        <img src={berita.gambar_url} alt={berita.judul} loading="lazy" class="h-44 w-full object-cover transition duration-300 group-hover:scale-105" />
      </span>
    ) : (
      <span class="grid h-44 w-full place-items-center bg-kabut" aria-hidden="true">
        <span class="font-display text-5xl font-bold text-madrasah/30">P</span>
      </span>
    )}
    <span class="flex flex-1 flex-col p-5">
      <span class="mb-2 inline-flex w-fit items-center rounded-full bg-kabut px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-madrasah">{berita.kategori_nama ?? 'Berita'}</span>
      <span class="font-display block text-lg font-bold leading-snug text-rimba decoration-kunyit decoration-2 underline-offset-4 line-clamp-2 group-hover:underline">{berita.judul}</span>
      <span class="mt-1.5 block text-sm leading-relaxed text-neutral-600 line-clamp-2">{berita.ringkasan}</span>
      <span class="mt-auto flex flex-wrap items-center gap-x-2.5 gap-y-1 pt-4 text-xs text-neutral-500">
        <span class="inline-flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          {berita.penulis}
        </span>
        <span aria-hidden="true">•</span>
        <span>{tanggal}</span>
        <span aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          {berita.views ?? 0}
        </span>
      </span>
    </span>
    <span class="h-1 bg-kunyit opacity-0 transition duration-300 group-hover:opacity-100" aria-hidden="true"></span>
  </a>
)}
